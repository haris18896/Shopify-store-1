<main class="page-width">
  <h1>{{ shop.name | escape }} gift card</h1>
  <p>{{ gift_card.initial_value | money }}</p>
  <p>{{ gift_card.code | format_code }}</p>
  {% comment %}theme-check-disable UnknownFilter{% endcomment %}
  <div>{{ gift_card.qr_identifier | qr_code: 120 }}</div>
  {% comment %}theme-check-enable UnknownFilter{% endcomment %}
  {% if gift_card.pass_url %}
    <a href="{{ gift_card.pass_url }}">
      <img
        src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
        alt="Add to Apple Wallet"
        width="120"
        height="40"
      >
    </a>
  {% endif %}
</main>
