{% if section.blocks.size > 0 %}
  <aside class="announcement-bar" aria-label="Store announcements">
    <div class="announcement-bar__inner page-width">
      {% for block in section.blocks %}
        <div class="announcement-bar__item announcement-bar__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% case block.settings.icon %}
            {% when 'delivery' %}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
            {% when 'box' %}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10"/></svg>
            {% when 'tag' %}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 12 12 3h7l2 2v7l-9 9-9-9Zm13-5h.01"/></svg>
          {% endcase %}
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{{ block.settings.text | escape }}{% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [{
    "type": "announcement", "name": "Announcement",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "delivery", "options": [
        { "value": "delivery", "label": "Delivery" }, { "value": "box", "label": "Box" }, { "value": "tag", "label": "Tag" }
      ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Free delivery over your chosen amount" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Announcement bar", "blocks": [
    { "type": "announcement", "settings": { "icon": "delivery", "text": "Free delivery over PKR 5,000" } },
    { "type": "announcement", "settings": { "icon": "box", "text": "Cash on delivery available" } },
    { "type": "announcement", "settings": { "icon": "tag", "text": "Mid-season sale up to 40% off" } }
  ] }]
}
{% endschema %}
