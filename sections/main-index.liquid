{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign brand_blocks = section.blocks | where: 'type', 'brand'
%}
<div class="home" data-home-section="{{ section.id }}">
  {% render 'hero-slider', slide_blocks: slide_blocks, section_id: section.id, autoplay: section.settings.hero_autoplay, speed: section.settings.hero_speed, fallback_mode: 'home' %}
  {% render 'category-rail', category_blocks: category_blocks %}

  <section class="home-section page-width" aria-labelledby="Featured-{{ section.id }}">
    <div class="section-heading"><h2 id="Featured-{{ section.id }}">{{ section.settings.featured_heading | escape }}</h2><a href="{{ section.settings.featured_link | default: routes.collections_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="feature-grid">
      {% for block in feature_blocks %}
        {% assign chosen_collection = block.settings.collection %}
        <article class="feature-card" {{ block.shopify_attributes }}>
          {% liquid
            assign feature_image = block.settings.image | default: chosen_collection.image
            case forloop.index
              when 1
                assign feature_asset = 'new-in-feature-eastern-wear.png'
              when 2
                assign feature_asset = 'new-in-feature-western-wear.png'
              when 3
                assign feature_asset = 'new-in-feature-kids.png'
              when 4
                assign feature_asset = 'new-in-feature-baby.png'
              else
                assign feature_asset = 'new-in-feature-watches.png'
            endcase
          %}
          {% if feature_image != blank %}{{ feature_image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(max-width: 749px) 48vw, 20vw', loading: 'lazy', alt: block.settings.heading }}{% else %}<img src="{{ feature_asset | asset_url }}" width="1448" height="1086" loading="lazy" alt="{{ block.settings.heading | escape }}">{% endif %}
          <div><h3>{{ block.settings.heading | default: chosen_collection.title | escape }}</h3><p>{{ block.settings.text | escape }}</p><a href="{{ block.settings.link | default: chosen_collection.url | default: routes.collections_url }}">Shop now <span aria-hidden="true">→</span></a></div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section page-width" aria-labelledby="Bestsellers-{{ section.id }}">
    <div class="section-heading"><h2 id="Bestsellers-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2><a href="{{ section.settings.product_collection.url | default: routes.all_products_collection_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="product-grid">
      {% for product in section.settings.product_collection.products limit: section.settings.products_to_show %}
        {% liquid
          case forloop.index
            when 1
              assign product_fallback_asset = 'new-in-product-womens-suit.png'
            when 2
              assign product_fallback_asset = 'new-in-product-mens-shirt.png'
            when 3
              assign product_fallback_asset = 'new-in-product-girls-dress.png'
            when 4
              assign product_fallback_asset = 'new-in-product-boys-hoodie.png'
            when 5
              assign product_fallback_asset = 'new-in-product-sneakers.png'
            else
              assign product_fallback_asset = 'new-in-category-accessories.png'
          endcase
        %}
        {% render 'product-card', card_product: product, fallback_asset: product_fallback_asset %}
      {% else %}
        {% for i in (1..6) %}
          {% liquid
            case i
              when 1
                assign product_asset = 'new-in-product-womens-suit.png'
                assign product_title = 'Embroidered Lawn Suit'
              when 2
                assign product_asset = 'new-in-product-mens-shirt.png'
                assign product_title = 'Classic Oxford Shirt'
              when 3
                assign product_asset = 'new-in-product-girls-dress.png'
                assign product_title = 'Ruffle Dress for Girls'
              when 4
                assign product_asset = 'new-in-product-boys-hoodie.png'
                assign product_title = 'Kids Hoodie'
              when 5
                assign product_asset = 'new-in-product-sneakers.png'
                assign product_title = 'Casual Sneakers'
              else
                assign product_asset = 'new-in-category-accessories.png'
                assign product_title = 'Structured Handbag'
            endcase
          %}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media"><img src="{{ product_asset | asset_url }}" width="1448" height="1086" loading="lazy" alt="{{ product_title }}"></div>
            <div class="product-card__content"><h3>{{ product_title }}</h3><p class="product-card__setup">Connect your products in the Theme Editor.</p><a class="quick-add quick-add--link" href="{{ routes.all_products_collection_url }}">Shop products</a></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </section>

  <section class="promo-grid page-width" aria-label="Special offers">
    <article class="promo-card promo-card--bundle">
      {% if section.settings.bundle_image != blank %}{{ section.settings.bundle_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 749px) 85vw, 33vw', loading: 'lazy', alt: section.settings.bundle_heading }}{% else %}<img src="{{ 'new-in-promo-bundle.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Folded clothing bundle">{% endif %}
      <div class="promo-card__copy"><h2>{{ section.settings.bundle_heading | escape }}</h2><p>{{ section.settings.bundle_text | escape }}</p>{% if section.settings.bundle_button != blank %}<a class="button" href="{{ section.settings.bundle_link | default: routes.all_products_collection_url }}">{{ section.settings.bundle_button | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
    </article>
    <article class="promo-card promo-card--buy-two">
      {% if section.settings.promo_image != blank %}{{ section.settings.promo_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 749px) 85vw, 33vw', loading: 'lazy', alt: section.settings.promo_heading }}{% else %}<img src="{{ 'new-in-promo-buy-two.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Clothing selected for a multibuy offer">{% endif %}
      <div class="promo-card__copy"><h2>{{ section.settings.promo_heading | escape }}</h2><p>{{ section.settings.promo_text | escape }}</p>{% if section.settings.promo_button != blank %}<a class="button" href="{{ section.settings.promo_link | default: routes.all_products_collection_url }}">{{ section.settings.promo_button | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
    </article>
    <article class="promo-card promo-card--newsletter">
      {% if section.settings.signup_image != blank %}{{ section.settings.signup_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 749px) 85vw, 33vw', loading: 'lazy', alt: section.settings.signup_heading }}{% else %}<img src="{{ 'new-in-promo-newsletter.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Botanical newsletter background">{% endif %}
      <div class="promo-card__copy"><h2>{{ section.settings.signup_heading | escape }}</h2><p>{{ section.settings.signup_text | escape }}</p>{% form 'customer', class: 'promo-signup' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="PromoEmail-{{ section.id }}">Email address</label><input id="PromoEmail-{{ section.id }}" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="Enter your email address" autocomplete="email" required><button type="submit" aria-label="Subscribe">→</button>{% if form.posted_successfully? %}<p class="form-message" role="status">Thanks for signing up.</p>{% endif %}{% if form.errors %}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div>
    </article>
  </section>

  {% if brand_blocks.size > 0 %}<section class="brand-rail page-width" aria-labelledby="Brands-{{ section.id }}"><h2 id="Brands-{{ section.id }}">{{ section.settings.brands_heading | escape }}</h2><div>{% for block in brand_blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '120px', loading: 'lazy', alt: block.settings.name }}{% else %}<span>{{ block.settings.name | escape }}</span>{% endif %}</a>{% endfor %}</div></section>{% endif %}

  <section class="home-section kids-collections page-width" aria-labelledby="Kids-{{ section.id }}">
    <div class="section-heading"><h2 id="Kids-{{ section.id }}">{{ section.settings.kids_heading | escape }}</h2><a href="{{ section.settings.kids_link | default: routes.collections_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="kids-grid">
      <a class="kids-card" href="{{ section.settings.toys_link | default: routes.all_products_collection_url }}"><img src="{{ 'new-in-kids-toys.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Teddy bear and wooden toys"><span><strong>Toys &amp; Games</strong><small>Learning through play</small><b>Shop Toys →</b></span></a>
      <a class="kids-card" href="{{ section.settings.girls_link | default: routes.all_products_collection_url }}"><img src="{{ 'new-in-kids-girls.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Girl wearing a pink floral dress"><span><strong>Girls Collection</strong><small>Cute styles for bright personalities</small><b>Shop Girls →</b></span></a>
      <a class="kids-card" href="{{ section.settings.boys_link | default: routes.all_products_collection_url }}"><img src="{{ 'new-in-kids-boys.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Boy wearing a blue shirt"><span><strong>Boys Collection</strong><small>Made for adventure</small><b>Shop Boys →</b></span></a>
      <a class="kids-card" href="{{ section.settings.baby_link | default: routes.all_products_collection_url }}"><img src="{{ 'new-in-kids-baby.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="Baby wearing a soft teddy outfit"><span><strong>Baby Collection</strong><small>Softness for every little milestone</small><b>Shop Baby →</b></span></a>
    </div>
  </section>

  {% render 'store-benefits', returns_text: section.settings.returns_text, delivery_text: section.settings.delivery_text %}
</div>
<nav class="mobile-dock" aria-label="Quick navigation"><a href="{{ routes.root_url }}" aria-current="page"><span aria-hidden="true">⌂</span>New In</a><a href="{{ routes.collections_url }}"><span aria-hidden="true">▦</span>Categories</a><a href="{{ routes.search_url }}"><span aria-hidden="true">⌕</span>Search</a>{% if section.settings.mobile_wishlist_link != blank %}<a href="{{ section.settings.mobile_wishlist_link }}"><span aria-hidden="true">♡</span>Wishlist</a>{% endif %}<a href="{{ routes.cart_url }}"><span aria-hidden="true">🛒</span>Cart{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a></nav>

{% schema %}
{
  "name": "New In landing page",
  "settings": [
    { "type": "header", "content": "Hero slideshow" },
    { "type": "checkbox", "id": "hero_autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "hero_speed", "label": "Change slide every", "min": 3, "max": 9, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Featured collections" },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "url", "id": "featured_link", "label": "View all link" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "product_collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 10, "step": 1, "default": 6 },
    { "type": "header", "content": "Offers" },
    { "type": "image_picker", "id": "bundle_image", "label": "Bundle deal image" },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "Bundle Deals" },
    { "type": "text", "id": "bundle_text", "label": "Bundle text", "default": "More Style, More Savings" },
    { "type": "text", "id": "bundle_button", "label": "Bundle button", "default": "Shop Bundle Deals" },
    { "type": "url", "id": "bundle_link", "label": "Bundle link" },
    { "type": "image_picker", "id": "promo_image", "label": "Image" },
    { "type": "text", "id": "promo_heading", "label": "Heading", "default": "Buy 2, Get 1 Free" },
    { "type": "text", "id": "promo_text", "label": "Text", "default": "Across selected categories" },
    { "type": "text", "id": "promo_button", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "promo_link", "label": "Button link" },
    { "type": "image_picker", "id": "signup_image", "label": "Signup image" },
    { "type": "text", "id": "signup_heading", "label": "Signup heading", "default": "Extra 10% Off with Signup" },
    { "type": "text", "id": "signup_text", "label": "Signup text", "default": "Join our newsletter and get 10% off your first order." },
    { "type": "header", "content": "Brands and benefits" },
    { "type": "text", "id": "brands_heading", "label": "Brands heading", "default": "Featured Brands" },
    { "type": "header", "content": "Toys and kids collections" },
    { "type": "text", "id": "kids_heading", "label": "Heading", "default": "Toys & Kids Collections" },
    { "type": "url", "id": "kids_link", "label": "View all link" },
    { "type": "url", "id": "toys_link", "label": "Toys link" },
    { "type": "url", "id": "girls_link", "label": "Girls link" },
    { "type": "url", "id": "boys_link", "label": "Boys link" },
    { "type": "url", "id": "baby_link", "label": "Baby link" },
    { "type": "text", "id": "returns_text", "label": "Returns note", "default": "Hassle-free returns" },
    { "type": "text", "id": "delivery_text", "label": "Delivery note", "default": "Reliable nationwide delivery" },
    { "type": "url", "id": "mobile_wishlist_link", "label": "Mobile wishlist app link" }
  ],
  "blocks": [
    { "type": "slide", "name": "Hero slide", "limit": 4, "settings": [
      { "type": "image_picker", "id": "image", "label": "Desktop image" }, { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" }, { "type": "text", "id": "heading", "label": "Heading", "default": "New Season, Premium Style" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Modern fashion for every generation. Timeless looks, everyday moments.</p>" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }, { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "textarea", "id": "badge", "label": "Badge text", "default": "Flat\n20% Off" }
    ] },
    { "type": "category", "name": "Category", "limit": 8, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Category" }, { "type": "url", "id": "link", "label": "Custom link" }
    ] },
    { "type": "feature", "name": "Featured collection card", "limit": 5, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Collection" }, { "type": "text", "id": "text", "label": "Text", "default": "Everyday style, thoughtfully made." },
      { "type": "url", "id": "link", "label": "Custom link" }
    ] },
    { "type": "brand", "name": "Brand", "limit": 10, "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" }, { "type": "text", "id": "name", "label": "Name", "default": "Brand name" }, { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "New In landing page", "blocks": [
    { "type": "slide", "settings": { "eyebrow": "New season", "heading": "New Season, Premium Style", "button_label": "Shop now", "badge": "Flat\n20% Off" } },
    { "type": "slide", "settings": { "eyebrow": "The festive edit", "heading": "Modern Grace, Crafted for You", "button_label": "Shop Women", "badge": "New\nIn" } },
    { "type": "slide", "settings": { "eyebrow": "Refined essentials", "heading": "Menswear for Every Moment", "button_label": "Shop Men", "badge": "Fresh\nEdit" } },
    { "type": "category", "settings": { "title": "Women" } }, { "type": "category", "settings": { "title": "Men" } }, { "type": "category", "settings": { "title": "Girls" } }, { "type": "category", "settings": { "title": "Boys" } },
    { "type": "category", "settings": { "title": "Baby" } }, { "type": "category", "settings": { "title": "Toys" } }, { "type": "category", "settings": { "title": "Watches" } }, { "type": "category", "settings": { "title": "Accessories" } },
    { "type": "feature", "settings": { "heading": "Eastern Wear", "text": "Elegant traditions for modern you." } }, { "type": "feature", "settings": { "heading": "Western Wear", "text": "Everyday style reimagined." } },
    { "type": "feature", "settings": { "heading": "Kids Essentials", "text": "Play. Explore. Grow." } }, { "type": "feature", "settings": { "heading": "Baby Basics", "text": "Soft beginnings for bright tomorrows." } },
    { "type": "feature", "settings": { "heading": "Premium Watches", "text": "Time for what matters." } },
    { "type": "brand", "settings": { "name": "ATELIER" } }, { "type": "brand", "settings": { "name": "MORROW" } }, { "type": "brand", "settings": { "name": "NORTH & CO." } }, { "type": "brand", "settings": { "name": "FORM" } }
  ] }]
}
{% endschema %}
