{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign brand_blocks = section.blocks | where: 'type', 'brand'
%}
<div class="home" data-home-section="{{ section.id }}">
  <section class="hero page-width" aria-roledescription="carousel" aria-label="Featured promotions" data-slider>
    <div class="hero__track">
      {% for block in slide_blocks %}
        <article class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
          <picture>
            {% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">{% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '(max-width: 749px) 100vw, 1440px', loading: 'eager', fetchpriority: 'high', alt: block.settings.image.alt }}
            {% else %}<img src="{{ 'home-hero.jpg' | asset_url }}" width="1916" height="821" loading="eager" fetchpriority="high" alt="Elegant fashion campaign">{% endif %}
          </picture>
          <div class="hero__copy">
            {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
            <h1>{{ block.settings.heading | escape }}</h1>
            {% if block.settings.text != blank %}<div class="hero__text">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.button_label != blank %}<a class="button" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
          </div>
          {% if block.settings.badge != blank %}<div class="hero__badge">{{ block.settings.badge | newline_to_br }}</div>{% endif %}
        </article>
      {% else %}
        <article class="hero__slide is-active" data-slide><img src="{{ 'home-hero.jpg' | asset_url }}" width="1916" height="821" loading="eager" fetchpriority="high" alt="Elegant fashion campaign"><div class="hero__copy"><p class="eyebrow">New season</p><h1>New Season,<br>Premium Style</h1><p>Modern fashion for every generation. Timeless looks, everyday moments.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop now <span aria-hidden="true">→</span></a></div></article>
      {% endfor %}
    </div>
    {% if slide_blocks.size > 1 %}<button class="slider-arrow slider-arrow--prev" type="button" data-prev aria-label="Previous slide">‹</button><button class="slider-arrow slider-arrow--next" type="button" data-next aria-label="Next slide">›</button><div class="slider-dots" aria-label="Choose slide">{% for block in slide_blocks %}<button type="button" data-dot="{{ forloop.index0 }}"{% if forloop.first %} class="is-active"{% endif %} aria-label="Show slide {{ forloop.index }}"></button>{% endfor %}</div>{% endif %}
  </section>

  {% if category_blocks.size > 0 %}
    <nav class="category-rail page-width" aria-label="Shop by category">
      {% for block in category_blocks %}
        {% assign chosen_collection = block.settings.collection %}
        <a href="{{ block.settings.link | default: chosen_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span>{% assign category_image = block.settings.image | default: chosen_collection.image %}{% if category_image != blank %}{{ category_image | image_url: width: 300 | image_tag: widths: '120, 180, 300', sizes: '110px', loading: 'lazy', alt: block.settings.title }}{% else %}<span class="category-fallback" role="img" aria-label="{{ block.settings.title | escape }}"></span>{% endif %}</span>{{ block.settings.title | default: chosen_collection.title | escape }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  <section class="home-section page-width" aria-labelledby="Featured-{{ section.id }}">
    <div class="section-heading"><h2 id="Featured-{{ section.id }}">{{ section.settings.featured_heading | escape }}</h2><a href="{{ section.settings.featured_link | default: routes.collections_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="feature-grid">
      {% for block in feature_blocks %}
        {% assign chosen_collection = block.settings.collection %}
        <article class="feature-card" {{ block.shopify_attributes }}>
          {% assign feature_image = block.settings.image | default: chosen_collection.image %}
          {% if feature_image != blank %}{{ feature_image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(max-width: 749px) 48vw, 20vw', loading: 'lazy', alt: block.settings.heading }}{% else %}<span class="feature-fallback" role="img" aria-label="{{ block.settings.heading | escape }}"></span>{% endif %}
          <div><h3>{{ block.settings.heading | default: chosen_collection.title | escape }}</h3><p>{{ block.settings.text | escape }}</p><a href="{{ block.settings.link | default: chosen_collection.url | default: routes.collections_url }}">Shop now <span aria-hidden="true">→</span></a></div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="home-section page-width" aria-labelledby="Bestsellers-{{ section.id }}">
    <div class="section-heading"><h2 id="Bestsellers-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2>{% if section.settings.product_collection != blank %}<a href="{{ section.settings.product_collection.url }}">View all <span aria-hidden="true">→</span></a>{% endif %}</div>
    <div class="product-grid">
      {% for product in section.settings.product_collection.products limit: section.settings.products_to_show %}{% render 'product-card', card_product: product %}
      {% else %}{% for i in (1..4) %}<article class="product-card product-card--placeholder"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="product-card__content"><h3>Choose a featured collection</h3><p class="product-card__price"><strong>{{ 4490 | money }}</strong></p><a class="quick-add quick-add--link" href="{{ routes.all_products_collection_url }}">Shop products</a></div></article>{% endfor %}{% endfor %}
    </div>
  </section>

  <section class="campaign page-width" aria-label="{{ section.settings.promo_heading | escape }}">
    <div class="campaign__copy"><h2>{{ section.settings.promo_heading | escape }}</h2><p>{{ section.settings.promo_text | escape }}</p>{% if section.settings.promo_button != blank %}<a class="button" href="{{ section.settings.promo_link | default: routes.all_products_collection_url }}">{{ section.settings.promo_button | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
    {% if section.settings.promo_image != blank %}{{ section.settings.promo_image | image_url: width: 2000 | image_tag: widths: '750, 1200, 1600, 2000', sizes: '100vw', loading: 'lazy', alt: section.settings.promo_heading }}{% else %}<img src="{{ 'home-campaign.jpg' | asset_url }}" width="1916" height="821" loading="lazy" alt="Folded embroidered fabrics">{% endif %}
  </section>

  {% if brand_blocks.size > 0 %}<section class="brand-rail page-width" aria-labelledby="Brands-{{ section.id }}"><h2 id="Brands-{{ section.id }}">{{ section.settings.brands_heading | escape }}</h2><div>{% for block in brand_blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.logo %}{{ block.settings.logo | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '120px', loading: 'lazy', alt: block.settings.name }}{% else %}<span>{{ block.settings.name | escape }}</span>{% endif %}</a>{% endfor %}</div></section>{% endif %}

  <section class="trust-strip page-width" aria-label="Store benefits">
    <div><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 2 8 3v6c0 5-3 9-8 11-5-2-8-6-8-11V5l8-3Zm-4 10 3 3 5-6"/></svg><span><strong>Authentic products</strong><small>Quality you can trust</small></span></div>
    <div><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m3 7 9-5 9 5-9 5-9-5Zm0 0v10l9 5 9-5V7M12 12v10"/></svg><span><strong>Easy returns</strong><small>{{ section.settings.returns_text | escape }}</small></span></div>
    <div><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 15v2"/></svg><span><strong>Secure checkout</strong><small>Your data is protected</small></span></div>
    <div><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg><span><strong>Fast delivery</strong><small>{{ section.settings.delivery_text | escape }}</small></span></div>
  </section>
</div>
<nav class="mobile-dock" aria-label="Quick navigation"><a href="{{ routes.root_url }}" aria-current="page"><span aria-hidden="true">⌂</span>Home</a><a href="{{ routes.collections_url }}"><span aria-hidden="true">▦</span>Categories</a><a href="{{ routes.search_url }}"><span aria-hidden="true">⌕</span>Search</a>{% if section.settings.mobile_wishlist_link != blank %}<a href="{{ section.settings.mobile_wishlist_link }}"><span aria-hidden="true">♡</span>Wishlist</a>{% endif %}<a href="{{ routes.cart_url }}"><span aria-hidden="true">🛒</span>Cart{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a></nav>

{% schema %}
{
  "name": "Homepage",
  "settings": [
    { "type": "header", "content": "Featured collections" },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Featured Collections" },
    { "type": "url", "id": "featured_link", "label": "View all link" },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "product_collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 10, "step": 1, "default": 6 },
    { "type": "header", "content": "Campaign" },
    { "type": "image_picker", "id": "promo_image", "label": "Image" },
    { "type": "text", "id": "promo_heading", "label": "Heading", "default": "Buy 2, Get 1 Free" },
    { "type": "text", "id": "promo_text", "label": "Text", "default": "Across selected categories" },
    { "type": "text", "id": "promo_button", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "promo_link", "label": "Button link" },
    { "type": "header", "content": "Brands and benefits" },
    { "type": "text", "id": "brands_heading", "label": "Brands heading", "default": "Featured Brands" },
    { "type": "text", "id": "returns_text", "label": "Returns note", "default": "Hassle-free returns" },
    { "type": "text", "id": "delivery_text", "label": "Delivery note", "default": "Reliable nationwide delivery" },
    { "type": "url", "id": "mobile_wishlist_link", "label": "Mobile wishlist app link" }
  ],
  "blocks": [
    { "type": "slide", "name": "Hero slide", "limit": 4, "settings": [
      { "type": "image_picker", "id": "image", "label": "Desktop image" }, { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" }, { "type": "text", "id": "heading", "label": "Heading", "default": "New Season, Premium Style" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Modern fashion for every generation. Timeless looks, everyday moments.</p>" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }, { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "textarea", "id": "badge", "label": "Badge text", "default": "Flat\n20% Off" }
    ] },
    { "type": "category", "name": "Category", "limit": 8, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Category" }, { "type": "url", "id": "link", "label": "Custom link" }
    ] },
    { "type": "feature", "name": "Featured collection card", "limit": 5, "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Collection" }, { "type": "text", "id": "text", "label": "Text", "default": "Everyday style, thoughtfully made." },
      { "type": "url", "id": "link", "label": "Custom link" }
    ] },
    { "type": "brand", "name": "Brand", "limit": 10, "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" }, { "type": "text", "id": "name", "label": "Name", "default": "Brand name" }, { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Homepage", "blocks": [
    { "type": "slide" },
    { "type": "category", "settings": { "title": "Women" } }, { "type": "category", "settings": { "title": "Men" } }, { "type": "category", "settings": { "title": "Girls" } }, { "type": "category", "settings": { "title": "Boys" } },
    { "type": "category", "settings": { "title": "Baby" } }, { "type": "category", "settings": { "title": "Toys" } }, { "type": "category", "settings": { "title": "Watches" } }, { "type": "category", "settings": { "title": "Accessories" } },
    { "type": "feature", "settings": { "heading": "Eastern Wear", "text": "Elegant traditions for modern you." } }, { "type": "feature", "settings": { "heading": "Western Wear", "text": "Everyday style reimagined." } },
    { "type": "feature", "settings": { "heading": "Kids Essentials", "text": "Play. Explore. Grow." } }, { "type": "feature", "settings": { "heading": "Baby Basics", "text": "Soft beginnings for bright tomorrows." } },
    { "type": "feature", "settings": { "heading": "Premium Watches", "text": "Time for what matters." } },
    { "type": "brand", "settings": { "name": "ATELIER" } }, { "type": "brand", "settings": { "name": "MORROW" } }, { "type": "brand", "settings": { "name": "NORTH & CO." } }, { "type": "brand", "settings": { "name": "FORM" } }
  ] }]
}
{% endschema %}
