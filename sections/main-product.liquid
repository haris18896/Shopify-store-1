{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign related_collection = product.collections.first
%}
<section class="product-page page-width" aria-labelledby="product-title" data-product-handle="{{ product.handle }}">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span>{% if related_collection != blank %}<a href="{{ related_collection.url }}">{{ related_collection.title | escape }}</a><span aria-hidden="true">›</span>{% endif %}<span>{{ product.title | escape }}</span></nav>
  <div class="product-layout">
    <div class="product-gallery" data-product-gallery>
      {% if product.media.size > 1 %}<div class="product-gallery__thumbs">{% for media in product.media %}<button type="button" class="{% if forloop.first %}is-active{% endif %}" data-media-thumbnail="{{ media.id }}" aria-label="Show media {{ forloop.index }}">{{ media.preview_image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '78px', loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div>{% endif %}
      <div class="product-gallery__stage">
        {% for media in product.media %}
          <div class="product-gallery__media{% if forloop.first %} is-active{% endif %}" data-media="{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}{{ media | image_url: width: 1600 | image_tag: widths: '500, 800, 1200, 1600', sizes: '(max-width: 749px) 100vw, 55vw', loading: 'eager', alt: media.alt | default: product.title }}
              {% when 'video' %}{{ media | video_tag: controls: true, image_size: '1200x' }}
              {% when 'external_video' %}{{ media | external_video_tag }}
              {% when 'model' %}{{ media | model_viewer_tag }}
            {% endcase %}
          </div>
        {% else %}
          <img src="{{ 'women-blush-lawn-suit.jpg' | asset_url }}" width="1122" height="1402" loading="eager" alt="{{ product.title | escape }}">
        {% endfor %}
      </div>
    </div>

    <div class="product-info">
      {% if product.tags contains 'bestseller' %}<span class="product-info__badge">Bestseller</span>{% endif %}
      <h1 id="product-title">{{ product.title | escape }}</h1>
      {% if product.vendor != blank %}<p class="product-info__vendor">{{ product.vendor | escape }}</p>{% endif %}
      {% assign rating = product.metafields.reviews.rating.value %}
      {% if rating != blank %}<div class="product-info__rating" aria-label="Rated {{ rating.rating }} out of {{ rating.scale_max }}"><span aria-hidden="true">★★★★★</span> {{ rating.rating }}{% if product.metafields.reviews.rating_count != blank %} ({{ product.metafields.reviews.rating_count }} reviews){% endif %}</div>{% endif %}
      <div class="product-info__price" data-product-price><strong>{{ current_variant.price | money }}</strong>{% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}</div>
      {% if product.description != blank %}<div class="product-info__summary">{{ product.description | strip_html | truncatewords: 35 }}</div>{% endif %}

      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        {% unless product.has_only_default_variant %}
          <label for="Variant-{{ section.id }}">Options</label>
          <select id="Variant-{{ section.id }}" name="id" data-variant-select>
            {% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
          </select>
        {% else %}<input type="hidden" name="id" value="{{ current_variant.id }}">{% endunless %}
        <label for="Quantity-{{ section.id }}">Quantity</label>
        <div class="quantity"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}" value="{{ current_variant.quantity_rule.min | default: 1 }}"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div>
        <button class="button product-form__add" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
        {% if section.settings.show_dynamic_checkout %}<div class="product-form__buy">{{ form | payment_button }}</div>{% endif %}
      {% endform %}

      <div class="product-assurances"><span>🚚 <strong>Free delivery</strong><small>On qualifying orders</small></span><span>↻ <strong>Easy returns</strong><small>{{ section.settings.returns_text | escape }}</small></span><span>♢ <strong>Secure checkout</strong><small>Protected payment</small></span></div>
      {% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}
    </div>
  </div>

  <div class="product-details">
    <details open><summary>Description</summary><div class="rte">{{ product.description }}</div></details>
    {% if product.metafields.custom.size_guide != blank %}<details><summary>Size guide</summary><div class="rte">{{ product.metafields.custom.size_guide | metafield_tag }}</div></details>{% endif %}
    <details><summary>Delivery &amp; returns</summary><div class="rte">{{ section.settings.delivery_text }}</div></details>
  </div>
</section>

{% if related_collection != blank and related_collection.products.size > 1 %}
  <section class="home-section page-width" aria-labelledby="Related-{{ section.id }}"><div class="section-heading"><h2 id="Related-{{ section.id }}">You May Also Like</h2><a href="{{ related_collection.url }}">View all <span aria-hidden="true">→</span></a></div><div class="product-grid">{% assign shown = 0 %}{% for related_product in related_collection.products %}{% unless related_product.id == product.id %}{% if shown < 5 %}{% render 'product-card', card_product: related_product %}{% assign shown = shown | plus: 1 %}{% endif %}{% endunless %}{% endfor %}</div></section>
{% endif %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout", "default": true },
    { "type": "text", "id": "returns_text", "label": "Returns note", "default": "Within 7 days" },
    { "type": "richtext", "id": "delivery_text", "label": "Delivery and returns", "default": "<p>Delivery times and rates are shown at checkout. Eligible items may be returned according to the store return policy.</p>" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
