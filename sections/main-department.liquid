{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign circle_blocks = section.blocks | where: 'type', 'circle'
  assign trend_blocks = section.blocks | where: 'type', 'trend'
  assign category_blocks = section.blocks | where: 'type', 'shop_category'
  assign promo_blocks = section.blocks | where: 'type', 'promo'
  assign product_source = section.settings.product_collection | default: collection
  assign department_handle = collection.handle | default: 'women'

  case department_handle
    when 'men'
      assign fallback_assets = 'new-in-product-mens-shirt.png,new-in-feature-western-wear.png,new-in-feature-eastern-wear.png,new-in-category-men.png,new-in-product-sneakers.png,new-in-feature-watches.png' | split: ','
      assign fallback_titles = 'Classic Oxford Shirt,Everyday T-Shirt,Embroidered Kurta,Tailored Trousers,Casual Sneakers,Classic Watch' | split: ','
    when 'girls'
      assign fallback_assets = 'new-in-product-girls-dress.png,new-in-kids-girls.png,new-in-feature-kids.png,new-in-category-girls.png,new-in-product-sneakers.png,new-in-category-accessories.png' | split: ','
      assign fallback_titles = 'Floral Cotton Dress,Party Dress,Everyday Set,Girls Essentials,Casual Sneakers,Hair Accessories' | split: ','
    when 'boys'
      assign fallback_assets = 'new-in-product-boys-hoodie.png,new-in-kids-boys.png,new-in-feature-kids.png,new-in-category-boys.png,new-in-product-sneakers.png,new-in-category-accessories.png' | split: ','
      assign fallback_titles = 'Essential Hoodie,Casual Shirt,Everyday Set,Boys Essentials,Casual Sneakers,Kids Accessories' | split: ','
    when 'baby'
      assign fallback_assets = 'new-in-kids-baby.png,new-in-feature-baby.png,new-in-category-baby.png,new-in-kids-baby.png,new-in-feature-kids.png,new-in-category-accessories.png' | split: ','
      assign fallback_titles = 'Knitted Romper,Baby Essentials,Newborn Set,Soft Layers,Playtime Essentials,Baby Accessories' | split: ','
    when 'toys'
      assign fallback_assets = 'new-in-kids-toys.png,new-in-category-toys.png,new-in-feature-kids.png,new-in-kids-toys.png,new-in-category-toys.png,new-in-category-accessories.png' | split: ','
      assign fallback_titles = 'Cuddly Teddy Bear,Educational Toys,Creative Play Set,Soft Toys,Outdoor Toys,Gift Ideas' | split: ','
    when 'watches'
      assign fallback_assets = 'new-in-feature-watches.png,new-in-category-watches.png,new-in-feature-watches.png,new-in-category-watches.png,new-in-category-accessories.png,new-in-feature-watches.png' | split: ','
      assign fallback_titles = 'Classic Analog Watch,Minimal Watch,Everyday Timepiece,Statement Watch,Watch Accessories,Premium Watch' | split: ','
    when 'accessories'
      assign fallback_assets = 'women-gold-accessories.jpg,women-classic-black-handbag.jpg,women-beige-handbag-editorial.jpg,women-nude-heels.jpg,new-in-category-watches.png,new-in-category-accessories.png' | split: ','
      assign fallback_titles = 'Gold Jewellery,Structured Handbag,Everyday Bag,Pointed-Toe Heels,Classic Watch,Statement Accessories' | split: ','
    else
      assign fallback_assets = 'women-blush-lawn-suit.jpg,women-sage-floral-dress.jpg,women-ivory-black-pret.jpg,women-lavender-pret.jpg,women-classic-black-handbag.jpg,women-nude-heels.jpg' | split: ','
      assign fallback_titles = 'Embroidered Lawn Suit,Floral Maxi Dress,Embroidered Pret,Lavender Pret,Structured Handbag,Pointed-Toe Heels' | split: ','
  endcase
%}

<div class="department department--{{ department_handle | handle }}" data-department-section="{{ section.id }}">
  {% render 'hero-slider', slide_blocks: slide_blocks, section_id: section.id, autoplay: section.settings.hero_autoplay, speed: section.settings.hero_speed %}
  {% render 'category-rail', category_blocks: circle_blocks %}

  {% if trend_blocks.size > 0 %}
    <section class="home-section page-width" aria-labelledby="Trending-{{ section.id }}">
      <div class="section-heading"><h2 id="Trending-{{ section.id }}">{{ section.settings.trending_heading | escape }}</h2><a href="{{ collection.url | default: routes.all_products_collection_url }}">View all <span aria-hidden="true">→</span></a></div>
      <div class="editorial-grid">
        {% for block in trend_blocks %}
          {% assign chosen_collection = block.settings.collection %}
          <article class="editorial-card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: chosen_collection.url | default: collection.url | default: routes.all_products_collection_url }}">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(max-width: 749px) 70vw, 25vw', loading: 'lazy', alt: block.settings.heading }}
              {% else %}
                <img src="{{ block.settings.asset | default: 'women-blush-lawn-suit.jpg' | asset_url }}" width="1122" height="1402" loading="lazy" alt="{{ block.settings.heading | escape }}">
              {% endif %}
              <span><strong>{{ block.settings.heading | default: chosen_collection.title | escape }}</strong><small>{{ block.settings.text | escape }}</small><b>{{ block.settings.button_label | default: 'Shop now' | escape }} <i aria-hidden="true">→</i></b></span>
            </a>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if category_blocks.size > 0 %}
    <section class="home-section page-width" aria-labelledby="Categories-{{ section.id }}">
      <div class="section-heading"><h2 id="Categories-{{ section.id }}">{{ section.settings.categories_heading | escape }}</h2><a href="{{ routes.collections_url }}">View all <span aria-hidden="true">→</span></a></div>
      <div class="department-category-grid">
        {% for block in category_blocks %}
          {% assign chosen_collection = block.settings.collection %}
          <a class="department-category-card" href="{{ block.settings.link | default: chosen_collection.url | default: collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '260, 420, 700', sizes: '(max-width: 749px) 42vw, 14vw', loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <img src="{{ block.settings.asset | default: 'women-blush-lawn-suit.jpg' | asset_url }}" width="1122" height="1402" loading="lazy" alt="{{ block.settings.title | escape }}">
            {% endif %}
            <span><strong>{{ block.settings.title | default: chosen_collection.title | escape }}</strong><small>{{ block.settings.button_label | default: 'Shop now' | escape }} <i aria-hidden="true">→</i></small></span>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="home-section page-width" aria-labelledby="Bestselling-{{ section.id }}">
    <div class="section-heading"><h2 id="Bestselling-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2><a href="{{ product_source.url | default: collection.url | default: routes.all_products_collection_url }}">View all <span aria-hidden="true">→</span></a></div>
    <div class="product-grid">
      {% for product in product_source.products limit: section.settings.products_to_show %}
        {% render 'product-card', card_product: product %}
      {% else %}
        {% for fallback_asset in fallback_assets %}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media"><img src="{{ fallback_asset | asset_url }}" width="1122" height="1402" loading="lazy" alt="{{ fallback_titles[forloop.index0] }}"></div>
            <div class="product-card__content"><h3>{{ fallback_titles[forloop.index0] }}</h3><p class="product-card__setup">Connect this section to a Shopify collection.</p><a class="quick-add quick-add--link" href="{{ collection.url | default: routes.all_products_collection_url }}">Shop products</a></div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </section>

  {% if promo_blocks.size > 0 %}
    <section class="department-promos page-width" aria-label="Featured edits">
      {% for block in promo_blocks %}
        <article class="department-promo" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '420, 700, 1000', sizes: '(max-width: 749px) 84vw, 33vw', loading: 'lazy', alt: block.settings.heading }}
          {% else %}
            <img src="{{ block.settings.asset | default: 'women-classic-black-handbag.jpg' | asset_url }}" width="1122" height="1402" loading="lazy" alt="{{ block.settings.heading | escape }}">
          {% endif %}
          <div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p><a class="button" href="{{ block.settings.link | default: collection.url | default: routes.all_products_collection_url }}">{{ block.settings.button_label | default: 'Shop now' | escape }} <span aria-hidden="true">→</span></a></div>
        </article>
      {% endfor %}
    </section>
  {% endif %}

  {% render 'store-benefits', returns_text: section.settings.returns_text, delivery_text: section.settings.delivery_text %}
</div>

