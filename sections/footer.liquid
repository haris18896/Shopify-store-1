<footer class="site-footer">
  {% if section.settings.show_newsletter %}
    <div class="footer-newsletter page-width">
      <div><h2>{{ section.settings.newsletter_heading | escape }}</h2><p>{{ section.settings.newsletter_text | escape }}</p></div>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
        <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Enter your email address" autocomplete="email" required>
        <button type="submit">Subscribe</button>
        {% if form.posted_successfully? %}<p class="form-message" role="status">Thanks for subscribing.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
  {% endif %}
  <div class="site-footer__inner page-width">
    <div class="footer-brand"><a class="site-logo" href="{{ routes.root_url }}"><svg class="site-logo__botanical" aria-hidden="true" viewBox="0 0 42 54"><path class="stem" d="M21 52c1-15 0-30-2-48M20 30c-7-4-11-9-13-15M20 22c7-4 11-9 13-15M20 39c-5-2-9-5-12-10M21 43c6-3 10-7 13-13"/><path class="leaf leaf--green" d="M7 15c7 0 10 4 12 10-7 0-11-4-12-10Zm27-8c-7 1-10 5-13 11 7-1 11-5 13-11ZM8 29c6 0 9 3 11 8-6 0-10-3-11-8Zm26 1c-6 0-10 4-12 10 7 0 11-4 12-10Z"/><path class="leaf leaf--peach" d="M15 4c4 3 5 7 4 13-5-3-6-8-4-13ZM3 22c5-1 10 1 14 6-6 2-11 0-14-6Zm35-5c-5 0-9 3-12 8 6 1 10-2 12-8Z"/></svg><span><strong>{{ section.settings.brand_name | escape }}</strong><small>{{ section.settings.tagline | escape }}</small></span></a><p>{{ section.settings.brand_text | escape }}</p></div>
    {% for i in (1..3) %}
      {% liquid
        assign menu_key = 'menu_' | append: i
        assign menu = section.settings[menu_key]
      %}
      {% if menu != blank %}<nav aria-label="{{ menu.title | escape }}"><h3>{{ menu.title | escape }}</h3><ul>{% for link in menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>{% endif %}
    {% endfor %}
    <div class="footer-payments"><h3>We accept</h3><div>{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}</div></div>
  </div>
  <div class="footer-bottom page-width"><small>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | escape }}. All rights reserved.</small>{% if section.settings.policies %}<nav aria-label="Policies"><ul>{% for policy in shop.policies %}{% if policy != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul></nav>{% endif %}</div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join our family" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Get exclusive offers, new arrivals and style inspiration." },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Jhoom" },
    { "type": "text", "id": "tagline", "label": "Brand tagline", "default": "Style for every story" },
    { "type": "text", "id": "brand_text", "label": "Brand description", "default": "Fashion, family and a brighter tomorrow." },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "footer" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu" },
    { "type": "link_list", "id": "menu_3", "label": "Third menu" },
    { "type": "checkbox", "id": "policies", "label": "Show policy links", "default": true }
  ]
}
{% endschema %}
