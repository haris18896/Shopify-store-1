<section class="account-page page-width" aria-labelledby="account-title">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span><span>My account</span></nav>
  <div class="account-layout">
    <aside class="account-sidebar">
      <div class="account-sidebar__profile"><span aria-hidden="true">{{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}</span><h2>Hi, {{ customer.first_name | default: customer.name | escape }}</h2><p>{{ customer.email | escape }}</p></div>
      <nav aria-label="Account"><a class="is-active" href="{{ routes.account_url }}">⌂ Dashboard</a><a href="#orders">□ My orders</a>{% if section.settings.wishlist_url != blank %}<a href="{{ section.settings.wishlist_url }}">♡ Wishlist</a>{% endif %}<a href="{{ routes.account_addresses_url }}">⌖ Addresses</a><a href="{{ routes.account_url }}#details">♙ Account details</a>{% if section.settings.rewards_url != blank %}<a href="{{ section.settings.rewards_url }}">☆ Style points</a>{% endif %}{% if section.settings.support_url != blank %}<a href="{{ section.settings.support_url }}">◌ Help &amp; support</a>{% endif %}<a href="{{ routes.account_logout_url }}">↪ Log out</a></nav>
    </aside>

    <div class="account-main">
      <header class="account-welcome"><div><h1 id="account-title">Good Morning,<br>{{ customer.first_name | default: customer.name | escape }}!</h1><p>Here’s what’s happening with your account.</p></div><img src="{{ 'women-blush-lawn-suit.jpg' | asset_url }}" width="1122" height="1402" loading="eager" alt=""></header>
      <div class="account-stats"><article><span>□</span><p>Orders</p><strong>{{ customer.orders_count }}</strong><a href="#orders">View orders →</a></article><article><span>⌖</span><p>Saved addresses</p><strong>{{ customer.addresses_count }}</strong><a href="{{ routes.account_addresses_url }}">Manage →</a></article><article><span>♙</span><p>Member since</p><strong>{{ customer.created_at | date: '%b %Y' }}</strong></article></div>

      <section class="account-panel" id="orders"><div class="section-heading"><h2>My Orders</h2></div>{% if customer.orders.size > 0 %}<div class="account-orders">{% paginate customer.orders by 6 %}{% for order in customer.orders %}<article><div><small>{{ order.name }}</small><h3>{{ order.created_at | date: '%d %b %Y' }}</h3><strong>{{ order.total_price | money_with_currency }}</strong></div><span class="account-order-status">{{ order.fulfillment_status_label }}</span><a href="{{ order.customer_url }}" aria-label="View {{ order.name }}">›</a></article>{% endfor %}{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div>{% else %}<div class="empty-state"><h3>No orders yet</h3><p>Your orders will appear here after checkout.</p><a class="button" href="{{ routes.all_products_collection_url }}">Start shopping</a></div>{% endif %}</section>

      <div class="account-panels">
        <section class="account-panel"><div class="section-heading"><h2>Saved Addresses</h2><a href="{{ routes.account_addresses_url }}">Manage addresses →</a></div>{% for address in customer.addresses limit: 2 %}<address><strong>{{ address.name }}</strong>{{ address | format_address }}</address>{% else %}<p>No saved addresses yet.</p>{% endfor %}</section>
        <section class="account-panel" id="details"><div class="section-heading"><h2>Account Details</h2></div><p><strong>{{ customer.name | escape }}</strong><br>{{ customer.email | escape }}{% if customer.phone != blank %}<br>{{ customer.phone | escape }}{% endif %}</p><a class="button button--secondary" href="{{ routes.account_addresses_url }}">Manage details</a></section>
      </div>
    </div>
  </div>

  <section class="home-section recently-viewed" aria-labelledby="RecentlyViewed-{{ section.id }}"><div class="section-heading"><h2 id="RecentlyViewed-{{ section.id }}">Recently Viewed</h2></div><div class="product-grid" data-recently-viewed><p>Products you view will appear here.</p></div></section>
</section>

{% schema %}
{
  "name": "Account dashboard",
  "settings": [
    { "type": "url", "id": "wishlist_url", "label": "Wishlist app page" },
    { "type": "url", "id": "rewards_url", "label": "Rewards app page" },
    { "type": "url", "id": "support_url", "label": "Support page" }
  ]
}
{% endschema %}
